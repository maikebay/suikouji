# Copy outside the repository and protect the real file with chmod 600.
# engine.runtime reads exported environment variables; it does not load .env files.
SUIKOUJI_DB=/var/lib/suikouji/staging.db
SUIKOUJI_BIND=127.0.0.1
SUIKOUJI_PORT=8765
SUIKOUJI_API_KEY=replace-with-a-random-secret-at-least-16-chars
SUIKOUJI_OWNER_ID=owner-1
SUIKOUJI_PRINCIPAL_ID=agent-api
SUIKOUJI_WORKSPACE_ID=shop-a
SUIKOUJI_API_ONLY=1

# iLink is OFF by default. Set all three to opt in; partial settings fail startup.
# DB, account and state must have distinct absolute paths outside the repository.
SUIKOUJI_ILINK_ACCOUNT_PATH=
SUIKOUJI_ILINK_STATE_PATH=
SUIKOUJI_ILINK_ALLOWED_PEERS=
# Example deployment paths; provision credentials separately, never paste tokens here.
# SUIKOUJI_ILINK_ACCOUNT_PATH=/etc/suikouji/secrets/weixin-account.json
# SUIKOUJI_ILINK_STATE_PATH=/var/lib/suikouji/weixin-state.json
# Exact peer IDs, comma separated, all bound to SUIKOUJI_WORKSPACE_ID; no wildcards.
# SUIKOUJI_ILINK_ALLOWED_PEERS=peer-id-1,peer-id-2
